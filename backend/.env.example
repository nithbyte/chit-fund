# ==============================================================================
# Durga Chit Fund Management System - Backend Environment Configuration Example
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production
API_PREFIX=api

# PostgreSQL Connection String (Host, Port, Database, User, Password, SSL mode)
DATABASE_URL="postgresql://username:password@localhost:5432/durga_chit_fund?schema=public&sslmode=prefer"

# Cryptographic Token & Session Settings (Must be at least 32 high-entropy characters)
JWT_SECRET="replace_with_a_secure_random_64_character_hex_or_base64_secret"
JWT_EXPIRES_IN="7d"

# API Rate Limiting (Throttle guard: Max requests per TTL window in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Allowed CORS Origins (Separate multiple origins with commas in production)
CORS_ORIGIN="http://localhost:5173,https://chitfund.example.com"
