# Durga Chit Fund Backend Environment Configuration Example
PORT=4000
NODE_ENV=development
API_PREFIX=api

# PostgreSQL Connection String
DATABASE_URL="postgresql://username:password@localhost:5432/durga_chit_fund_dev?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"
JWT_EXPIRES_IN="7d"

# Rate Limiting (Requests per TTL seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:5173"
