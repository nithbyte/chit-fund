# ==============================================================================
# Durga Chit Fund Management System - Production Environment Configuration
# Target: https://chit-fund.manammcare.com (Hostinger Node.js)
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production
API_PREFIX=api

# PostgreSQL Connection String (Replace with your Neon.tech / Supabase PostgreSQL URL)
# Example: postgresql://neondb_owner:npg_xyz@ep-cold-pond-a1b2c3d4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-your-instance.region.aws.neon.tech/neondb?sslmode=require"

# Cryptographic Token & Session Settings (High-entropy 64-character secret)
JWT_SECRET="abea48fe5d359203d13e4b08f149830920fb9eeb3887697f0df0c8b068298443"
JWT_EXPIRES_IN="7d"

# API Rate Limiting (Throttle guard: Max requests per TTL window in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Allowed CORS Origins (Comma-separated; vercel.app domains are also automatically permitted)
CORS_ORIGIN="https://chit-fund.manammcare.com,https://manammcare.com"
